ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MENDICOT_DISCONNECTED_PLAYER_GRACE_PERIOD_SECONDS=10
MENDICOT_TRICK_DISPLAY_DURATION_MS=1800
MENDICOT_FINAL_SCORE_DISPLAY_DURATION_MS=2500
MENDICOT_TRUMP_REVEAL_DURATION_MS=1500
MENDICOT_HIDDEN_CARD_RETURN_DURATION_MS=800

# Firebase Admin (choose one credential strategy; never commit credentials)
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# MENDICOT_FIREBASE_SERVICE_ACCOUNT_JSON={...}
# MENDICOT_FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=base64-encoded-service-account-json

# Test push requires both settings and is never enabled by default.
MENDICOT_ENV=production
MENDICOT_ENABLE_TEST_PUSH=false
